<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.lang.Double?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="client.gui.controllers.GameController">

    <VBox alignment="CENTER"
          spacing="10"
          style="-fx-background-color: #121212;
                 -fx-background-size: cover;
                 -fx-background-position: center;">

        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: #1a1a1a; -fx-padding: 5 10 5 10;">
            <Label text="MAGIC DUEL" style="-fx-text-fill: #555; -fx-font-size: 12px;" HBox.hgrow="ALWAYS">
                <maxWidth><Double fx:constant="MAX_VALUE" /></maxWidth>
            </Label>
            <Button text="—" onAction="#handleMinimize"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
            <Button text="▢" onAction="#handleWindowSize"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand;"/>
            <Button text="✕" onAction="#handleClose"
                    style="-fx-background-color: transparent; -fx-text-fill: #cf6679; -fx-font-size: 14px; -fx-cursor: hand;"/>
        </HBox>

        <padding>
            <Insets top="10" right="20" bottom="10" left="20"/>
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <Label fx:id="opponentNameLabel" text="Противник"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <StackPane>
                <HBox alignment="CENTER" spacing="10">
                    <ProgressBar fx:id="opponentHpBar" progress="1.0" prefWidth="400" prefHeight="20"
                                 style="-fx-accent: #cf6679;"/>
                    <Label fx:id="opponentHpText" text="15 / 15" style="-fx-text-fill: #cf6679; -fx-font-size: 16px;"/>
                </HBox>
                <Label fx:id="opponentDamageText" text="" opacity="0"
                       style="-fx-text-fill: #ff1744; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </StackPane>
        </VBox>

        <StackPane VBox.vgrow="ALWAYS">
            <HBox fx:id="battleField" alignment="CENTER" spacing="80" minHeight="340" prefHeight="340" VBox.vgrow="NEVER"
                  style="-fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 15; -fx-border-style: dashed;">
                <children>
                    <StackPane fx:id="opponentSlot" prefWidth="220" prefHeight="320" minHeight="320"
                               style="-fx-border-color: #444; -fx-border-radius: 10; -fx-background-color: rgba(255,255,255,0.02);"/>
                    <StackPane fx:id="playerSlot" prefWidth="220" prefHeight="320" minHeight="320"
                               onDragOver="#handleDragOver" onDragDropped="#handleDragDropped"
                               style="-fx-border-color: #03DAC5; -fx-border-radius: 10; -fx-background-color: rgba(3,218,197,0.05);">
                        <Label text="ТАЩИ СЮДА" style="-fx-text-fill: #03DAC5; -fx-opacity: 0.5;"/>
                    </StackPane>
                </children>
            </HBox>
        </StackPane>

        <VBox alignment="CENTER" spacing="5">
            <StackPane>
                <HBox alignment="CENTER" spacing="10">
                    <ProgressBar fx:id="playerHpBar" progress="1.0" prefWidth="400" prefHeight="20"
                                 style="-fx-accent: #03DAC5;"/>
                    <Label fx:id="playerHpText" text="15 / 15" style="-fx-text-fill: #03DAC5; -fx-font-size: 16px;"/>
                </HBox>
                <Label fx:id="playerDamageText" text="" opacity="0"
                       style="-fx-text-fill: #ff1744; -fx-font-size: 22px; -fx-font-weight: bold;"/>
            </StackPane>
            <Label fx:id="playerNameLabel" text="ВЫ"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>

        <ScrollPane fitToHeight="true"
                    vbarPolicy="NEVER"
                    hbarPolicy="ALWAYS"
                    minHeight="320"
                    prefHeight="320"
                    style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <HBox fx:id="cardsContainer"
                  alignment="CENTER_LEFT"
                  spacing="20"
                  style="-fx-padding: 15; -fx-min-width: 1200;">
            </HBox>
        </ScrollPane>

    </VBox>

    <StackPane fx:id="gameOverOverlay" visible="false" managed="false"
               style="-fx-background-color: rgba(0,0,0,0.85);"
               StackPane.alignment="CENTER">
        <VBox alignment="CENTER" spacing="30" maxWidth="450" maxHeight="350"
              style="-fx-background-color: #1e1e1e; -fx-border-color: #03DAC5; -fx-border-width: 3; -fx-border-radius: 20; -fx-background-radius: 20;">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>
            <Label fx:id="resultTitleLabel" text="ПОБЕДА!" style="-fx-text-fill: #03DAC5; -fx-font-size: 48px; -fx-font-weight: bold;"/>
            <Label fx:id="resultDetailsLabel" text="Вы одолели противника" style="-fx-text-fill: white; -fx-font-size: 18px;" wrapText="true" alignment="CENTER"/>
            <HBox spacing="20" alignment="CENTER">
                <Button text="В МЕНЮ" onAction="#handleReturnToMenu"
                        style="-fx-background-color: #333333;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-padding: 10 25;
                   -fx-background-radius: 8;
                   -fx-cursor: hand;
                   -fx-font-weight: bold;
                   -fx-border-color: #555;
                   -fx-border-radius: 8;"/>
                <Button text="ВЫЙТИ" onAction="#handleExitGame"
                        style="-fx-background-color: #cf6679;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-padding: 10 25;
                   -fx-background-radius: 8;
                   -fx-cursor: hand;
                   -fx-font-weight: bold;
                   -fx-border-color: #e57373;
                   -fx-border-radius: 8;"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>